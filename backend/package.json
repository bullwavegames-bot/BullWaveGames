{
  "name": "bullwave-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "start": "node dist/backend/src/index.js",
    "start:worker": "node dist/backend/src/worker.js",
    "migrate": "tsx src/sql/migrate.ts",
    "migrate:prod": "node dist/backend/src/sql/migrate.js",
    "seed": "tsx src/sql/seed.ts",
    "seed:prod": "node dist/backend/src/sql/seed.js",
    "test:integration:seed": "node scripts/verify-seed-preservation.mjs",
    "test:integration:support": "npm run build && node scripts/verify-support-workflow.mjs",
    "test:integration:catalog": "npm run build && node scripts/verify-catalog-edit.mjs",
    "test:integration:import": "npm run build && node scripts/verify-local-import.mjs",
    "test:integration:email": "npm run build && node scripts/verify-email-queue.mjs",
    "test:integration:identity": "node scripts/verify-identity-lifecycle.mjs && node scripts/verify-supabase-routes.mjs",
    "test:integration:billing": "npm run build && node scripts/verify-billing-integrity.mjs",
    "test:integration:webhooks": "npm run build && node scripts/verify-billing-webhooks.mjs",
    "test:integration:gameplay": "npm run build && node scripts/verify-gameplay-integrity.mjs",
    "promote-admin": "tsx src/cli/promote-admin.ts",
    "test": "node scripts/test.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/nodemailer": "^8.0.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.13"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/websocket": "^11.3.0",
    "@sentry/node": "^10.73.0",
    "argon2": "^0.45.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.3",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.1",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "razorpay": "^2.9.8",
    "typescript": "^7.0.2",
    "zod": "^3.25.76"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "esbuild@0.28.2": true
  }
}

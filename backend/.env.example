NODE_ENV=development
SERVICE_KIND=api
PORT=8787
HOST=127.0.0.1
SHUTDOWN_TIMEOUT_MS=15000

APP_URL=http://localhost:5173
API_URL=http://localhost:8787
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,https://bullwavegames.com,https://www.bullwavegames.com
# Required in production. Use only the CIDRs/addresses of your ingress proxies.
TRUSTED_PROXIES=

DATABASE_URL=postgres://bullwave:bullwave@127.0.0.1:5433/bullwave
REDIS_URL=redis://127.0.0.1:6380

# Use supabase in production. Legacy keeps the existing local backend login for migration/testing.
AUTH_MODE=legacy
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_SECRET=

JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
PLAY_SESSION_SECRET=change-me-play-session-secret-32chars

SENTRY_DSN=
MAIL_FROM=Bullwave Games <noreply@bullwavegames.com>
SMTP_URL=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_WAVE_MONTHLY=
RAZORPAY_PLAN_WAVE_ANNUAL=
RAZORPAY_PLAN_SURGE_MONTHLY=
RAZORPAY_PLAN_SURGE_ANNUAL=
RAZORPAY_PLAN_TIDE_MONTHLY=
RAZORPAY_PLAN_TIDE_ANNUAL=

GRACE_DAYS=3
ALLOW_DEV_BILLING=true
# local opens Bullwave's in-app test console; razorpay opens hosted checkout.
BILLING_MODE=razorpay
